# Copia este archivo como .env.local para desarrollo. En Vercel NO hace falta: la integración de
# Supabase del Marketplace crea sola NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# que la app ya sabe leer. Están en Supabase → Project Settings → API.
# Estas claves son públicas a propósito: la protección real son las políticas RLS de la base de datos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica

# Opcional: anti-bots en el registro (Cloudflare Turnstile). Solo la «site key», nunca la secreta.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
